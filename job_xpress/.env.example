# ===========================================
# JobXpress v1.1.0 - Configuration
# ===========================================

# --- Environnement ---
ENVIRONMENT=development  # development, staging, production

# --- Base de Données (Supabase) ---
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_KEY=votre-cle-anon-publique
# IMPORTANT: Utiliser la clé service_role pour le backend (bypass RLS)
# Trouver dans: Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_KEY=votre-cle-service-role
# JWT Secret pour validation des tokens (Settings > API > JWT Settings > JWT Secret)
SUPABASE_JWT_SECRET=votre-jwt-secret

# --- CORS (Production) ---
# Liste d'origines séparées par des virgules
ALLOWED_ORIGINS=http://localhost:3000,https://rocket-jobxpress.netlify.app

# --- SerpAPI (Google Jobs) ---
# Plan gratuit: 100 recherches/mois
SERPAPI_KEY=votre-cle-serpapi

# --- IA & Recherche ---
MISTRAL_API_KEY=votre-cle-mistral
RAPIDAPI_KEY=votre-cle-rapidapi

# --- LLM principal: MiMo-V2.5 via OpenCode Zen (depuis 2026-09-03) ---
# Variables nommees OPENROUTER_* par heritage — le provider accepte toute
# API compatible OpenAI (ici https://opencode.ai/zen/v1)
OPENROUTER_API_KEY=sk-votre-cle-opencode-zen
OPENROUTER_BASE_URL=https://opencode.ai/zen/v1
OPENROUTER_MODEL_MAIN=mimo-v2.5-free
OPENROUTER_MODEL_PREMIUM=mimo-v2.5-free
OPENROUTER_MODEL_FAST=mimo-v2.5-free
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=JobXpress

# --- OpenAI (optionnel : embeddings pgvector uniquement) ---
OPENAI_API_KEY=sk-votre-cle-openai
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Legacy (non utilises, conserves pour compat config) ---
DEEPSEEK_API_KEY=
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_PREMIUM=gpt-4o

# --- Email (Brevo API) ---
BREVO_API_KEY=xkeysib-votre-cle-brevo
SENDER_EMAIL=votre.email@valide-brevo.com

# --- Robustesse (Optionnel) ---
REQUEST_TIMEOUT=30
MAX_RETRIES=3
LOG_LEVEL=INFO
LOG_FILE=logs/jobxpress.log  # Vide pour désactiver

# --- Stripe (Paiements) ---
# Webhook signing secret pour vérifier l'authenticité des webhooks
# Trouver dans: Stripe Dashboard > Developers > Webhooks > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_votre_secret

# --- Monitoring (Production) ---
SENTRY_DSN=  # https://xxx@sentry.io/xxx

# --- Logging Cloud (Axiom) ---
# Axiom offre 500GB/mois gratuit - https://axiom.co
# Créer un dataset "jobxpress-logs" et un API Token avec permission "Ingest"
AXIOM_TOKEN=  # xaat-votre-token-axiom
AXIOM_DATASET=jobxpress-logs

# --- Redis Cache (Optionnel mais recommandé) ---
# Cache les résultats de recherche pour réduire les appels API
# Providers gratuits: Upstash (10k req/jour), Redis Cloud (30MB)
#
# Format Upstash: rediss://default:xxx@xxx.upstash.io:6379
# Format Redis Cloud: redis://default:xxx@xxx.cloud.redislabs.com:port
# Format Railway: redis://default:xxx@xxx.railway.internal:6379
REDIS_URL=
