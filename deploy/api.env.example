# ==================================================
# JobXpress API - variables VPS (copier vers .env.api)
# NE JAMAIS COMMMITTER AVEC DE VAIES SECRETS
# ==================================================

# --- Infrastructure commune (aussu lue par compose.yaml) ---
POSTGRES_PASSWORD=changeme
REDIS_PASSWORD=change-me
MINIO_ROOT_USER=jobxpress
MINIO_ROOT_PASSWORD=change-me-long
BETTER_AUTH_SECRET=openssl-rand-base64-32

# --- Application ---
ENVIRONMENT=production
LOG_LEVEL=INFO
ALLOWED_ORIGINS=https://app.jobxpress.fr

# --- LLM : MiMo-V2.5 via OpenCode Zen ---
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-xxx
OPENROUTER_BASE_URL=https://opencode.ai/zen/v1
OPENROUTER_MODEL_MAIN=mimo-v2.5-free
OPENROUTER_MODEL_PREMIUM=mimo-v2.5-free
OPENROUTER_MODEL_FAST=mimo-v2.5-free

# --- OpenAI (embeddings pgvector, a remplacer par FTS Postgres en phase 3) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Search / OCR / Email ---
SERPAPI_KEY=
RAPIDAPI_KEY=
MISTRAL_API_KEY=
BREVO_API_KEY=
SENDER_EMAIL=

# --- Stripe (nouveau webhook -> https://api.jobxpress.fr/webhooks/stripe) ---
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Auth (phase 3 : decouplage Supabase -> better-auth) ---
# SUPABASE_URL / SUPABASE_KEY / SUPABASE_SERVICE_KEY / SUPABASE_JWT_SECRET
# seront remplaces par BETTER_AUTH_* + DATABASE_URL

# --- Monitoring (optionnel) ---
SENTRY_DSN=
